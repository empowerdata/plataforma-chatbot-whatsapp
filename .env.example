# ---- Plano de controle (banco da plataforma) ----
# Vazio em dev = Postgres embutido (PGlite) em ./.data. Em produção, obrigatório.
DATABASE_URL=

# Chave-mestra que criptografa os segredos dos alunos. Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# URL pública (usada nos webhooks da Evolution e em links).
APP_URL=http://localhost:3000

# 1 = Evolution simulada + página /dev/simulador (ignorado em produção).
DEV_SIMULATOR=1

# Token das rotas internas (monitor de instâncias via cron).
INTERNAL_TOKEN=

# Chave OpenAI usada só no dev quando a conta ainda não configurou a dela.
DEV_OPENAI_API_KEY=

# Primeiro acesso (criado automaticamente se não existir nenhum usuário). Em
# produção, também cria e vincula a própria conta (instalação de conta única).
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ACCOUNT_NAME=

# Servidor Evolution já embutido na instalação (Docker Compose / Render):
# preenchidos, o painel cadastra ele sozinho, sem precisar de Admin → Servidores.
EVOLUTION_BUNDLED_HOST=
EVOLUTION_BUNDLED_PORT=
EVOLUTION_BUNDLED_API_KEY=
