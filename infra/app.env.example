# Copie para infra/app.env

# Chave que criptografa os segredos dos alunos. NUNCA troque depois de ter dados
# (senão as chaves salvas ficam ilegíveis). Gere com: openssl rand -hex 32
APP_SECRET=

# Token das rotas internas (cron do monitor). Gere com: openssl rand -hex 16
INTERNAL_TOKEN=

# Primeiro acesso (só usado se o banco estiver vazio) — já cria sua própria
# conta e cai direto no painel, sem precisar mexer em Admin → Contas.
BOOTSTRAP_ADMIN_EMAIL=voce@seudominio.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha
BOOTSTRAP_ACCOUNT_NAME=Nome do seu negócio
