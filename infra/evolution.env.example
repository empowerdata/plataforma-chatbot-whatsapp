# Copie para infra/evolution.env
# Referência completa: https://doc.evolution-api.com/v2/pt/env

# ---- Geral ----
SERVER_TYPE=http
SERVER_PORT=8080
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
DEL_INSTANCE=false
LANGUAGE=pt-BR

# ---- Banco (a URI vem do compose) ----
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution

# Guardar SÓ a sessão; conversas ficam no Supabase do aluno (promessa do produto).
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false

# ---- Cache ----
CACHE_REDIS_ENABLED=true
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---- Webhook (cada instância recebe a própria URL pelo painel) ----
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_LOGOUT_INSTANCE=true
WEBHOOK_EVENTS_REMOVE_INSTANCE=true

# ---- WhatsApp ----
CONFIG_SESSION_PHONE_CLIENT=Atendimento
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# ---- Autenticação (a chave vem do compose: AUTHENTICATION_API_KEY) ----
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
